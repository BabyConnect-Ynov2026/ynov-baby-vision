# BabyConnect API
API_BASE_URL=http://localhost:8080/api/v1
MATCH_ID=1

# Camera (0 = webcam, ou chemin vers une vidéo)
CAMERA_SOURCE=0

# YOLO model (yolov8n.pt = nano, yolov8s.pt = small, ...)
YOLO_MODEL=yolov8n.pt

# Seuil de confiance YOLO (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.5

# Coordonnées des lignes de but (en pixels, à calibrer selon la caméra)
# Format: x1,y1,x2,y2
GOAL_LEFT=100,0,100,480
GOAL_RIGHT=540,0,540,480

# Nombre de buts pour gagner
WIN_SCORE=10

# Debug mode (affiche la fenêtre OpenCV)
DEBUG=true
